rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberData(memberId) {
      return get(/databases/$(database)/documents/members/$(memberId)).data;
    }

    function isOwner(memberId) {
      return isSignedIn() && memberData(memberId).authUid == request.auth.uid;
    }

    function isClubVisibleCatch() {
      return resource.data.visibility == 'club' || resource.data.visibility == 'public_feed';
    }

    // CRM roster — active members readable when signed in
    match /members/{memberId} {
      allow read: if isSignedIn() && resource.data.isActive == true;
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['authUid', 'lastFishingAppLoginAt']);
    }

    // Fishing profile (private spots, gear, prefs) — owner-only by default. Firestore rules
    // are read-doc-level, not field-level, so a broad "any signed-in member can read" here
    // would expose privateSpots regardless of each spot's shareClub flag (that used to be
    // the case — filtering was client-side only). Anything meant to be club-visible lives in
    // a separate clubShare doc instead (below), which the owner writes with only the
    // already-shareClub:true subset — see fishingSyncService.js's saveFishingProfileToCloud.
    match /members/{memberId}/fishingProfile/{docId} {
      allow read: if isOwner(memberId);
      allow write: if isOwner(memberId);
    }

    // Club-visible spot subset — deliberately readable by any signed-in member; the owner
    // is still the only writer, so a member can't spoof another member's shared spots.
    match /members/{memberId}/fishingProfile/clubShare {
      allow read: if isSignedIn();
    }

    // Catch log — owner writes; club catches readable by all signed-in members
    match /members/{memberId}/fishingCatches/{catchId} {
      allow read: if isSignedIn() && (isOwner(memberId) || isClubVisibleCatch());
      allow create, delete: if isOwner(memberId);
      allow update: if isOwner(memberId)
        || (isSignedIn() && isClubVisibleCatch()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']));
    }
  }
}
